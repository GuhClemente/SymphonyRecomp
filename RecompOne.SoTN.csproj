<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>sotn</AssemblyName>
    <ApplicationIcon>assets/icon/SymphonyRecomp.ico</ApplicationIcon>
    <NoWarn>0162</NoWarn>
    <DefaultItemExcludes>$(DefaultItemExcludes);RecompOne/**;mods/**;tools/**;ghidra_files/**;tests/**</DefaultItemExcludes>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <EnableSourceLink>false</EnableSourceLink>
    <EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="RecompOne/RecompOne.Runtime/RecompOne.Runtime.csproj" UndefineProperties="OutputType" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="assets/tracker/*.png" />
    <EmbeddedResource Include="assets/map/*.png" />
    <EmbeddedResource Include="assets/extension/*.png" />
    <EmbeddedResource Include="assets/extension/room_fills.json" />
    <EmbeddedResource Include="assets/icon/*.ico" />
    <EmbeddedResource Include="assets/languages.json" />
  </ItemGroup>
</Project>
